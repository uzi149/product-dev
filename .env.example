# Copy to .env (git-ignored): `copy .env.example .env`
# Development defaults. Change every password before using a shared machine.

# Interface the Docker services listen on. 127.0.0.1 = this machine only.
BIND_ADDRESS=127.0.0.1

# PostgreSQL
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_password
POSTGRES_DB=sentinel
POSTGRES_HOST=127.0.0.1
# 5433 because a local PostgreSQL may already own 5432
POSTGRES_PORT=5433

# MinIO
MINIO_ACCESS_KEY=sentinel
MINIO_SECRET_KEY=sentinel_dev_password
MINIO_BUCKET=sentinel
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
# Address browsers use for presigned video URLs. Leave empty on one machine; set it
# (e.g. 192.168.1.20:9000) when the UI is opened from another computer.
MINIO_PUBLIC_ENDPOINT=

# Redis
REDIS_HOST=127.0.0.1
# 6380 because another Redis may already own 6379
REDIS_PORT=6380
# Database number for the job queue and live camera status (the e2e tests use their own, 1)
REDIS_DB=0

# MediaMTX (RTSP server)
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_RTSP_PORT=8554

# Key that encrypts camera source URIs (Fernet). This is a shared DEVELOPMENT key (ADR 0008):
# anyone with the repo can decrypt stored URIs. Before using real camera passwords, generate a
# private key for the installation and re-enter the camera URIs:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=b9aY7zaIQeW4GzPsbT1k0y4-Y5qC9GXwxg4_TVkvEDg=

# API
# Largest accepted MP4 upload, in megabytes.
MAX_UPLOAD_MB=2048
# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Vision-language model (ADR 0019). Check the setup with: python -m shared.model_adapters.check_vlm
# auto: the API below when a key is set, otherwise the local model in this process
# (CPU, about a minute or more per 12 s window, about 7.5 GB of memory). api / local force one.
VLM_BACKEND=auto
# Your OpenRouter key (https://openrouter.ai/keys); OPENROUTER_API_KEY works too.
# With a key set, keyframes of the analysed footage are SENT TO THIS SERVER: use only test videos.
# Real camera footage needs a local server below (a vLLM on the pilot) or no key.
VLM_API_KEY=
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct
VLM_LOCAL_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# Longest side of every picture sent to the model; per-request timeout; retries for temporary errors.
VLM_IMAGE_MAX_SIDE=640
VLM_TIMEOUT_SECONDS=180
VLM_MAX_RETRIES=6

# Automatic analysis of new segments (ADR 0021, 0022). The worker needs the analysis queue:
#   celery -A shared.jobs.celery_app worker --pool=solo -Q default,analysis
# false: nothing is queued and new segments stay pending; analyse them later with
#   python -m services.analysis.requeue --status pending --since 2h
ANALYSIS_ENABLED=true
# On start, an analysis worker queues the pending segments of this many past hours.
ANALYSIS_SWEEP_HOURS=24
# A segment analysing with no progress for this many minutes is shown as stuck and can be
# retried from the Cameras page (or: python -m services.analysis.requeue --status stuck).
ANALYSIS_STUCK_MINUTES=15

# Hybrid search (step 4.2): how each hit is scored. Defaults tuned on the acceptance clips.
# QUERY_WEIGHT_TEXT=0.45
# QUERY_WEIGHT_VISUAL=0.25
# QUERY_WEIGHT_KEYWORD=0.15
# QUERY_WEIGHT_ACTION=0.15
# QUERY_WEIGHT_EVENT=0.10
# Hits below this fused score (0-1) are not shown.
# QUERY_MIN_SCORE=0.2
# Clips on one camera at most this many minutes apart are one result, with the gap shown.
# QUERY_GROUP_GAP_MINUTES=10

# Embedding models (ADR 0020): always local, about 2 GB of memory per process that loads them.
# Fixed per installation: the first use records them in the database, and a process configured
# for other models refuses to start. Changing one means re-analysing the footage.
# Download ahead of time with: python -m shared.model_adapters.download_models
# Check with: python -m shared.model_adapters.check_embeddings
TEXT_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
IMAGE_EMBEDDING_MODEL=google/siglip2-base-patch16-224
# CPU threads for the embedding models; 0 = half the cores.
EMBEDDING_THREADS=0

# Change detection defaults (ADR 0010). A camera can override each of them, and add
# ignore-polygons, in its detection_config JSON.
# Grey-level difference (0-255) for a pixel to count as changed.
DETECT_PIXEL_DELTA=25
# Share of the (unmasked) image that must change: 0.001 = 0.1% (a person far away in a wide view
# covers 0.05-0.3% of the picture).
DETECT_CHANGED_FRACTION=0.001
# A changed pixel only counts when its local structural similarity is below this, so
# lighting changes (which keep the structure) are ignored.
DETECT_SSIM_THRESHOLD=0.7
# Consecutive changed samples (1 per second) before the camera counts as active.
DETECT_ACTIVATION_SAMPLES=2
# How fast the background follows slow scene changes while idle.
DETECT_BACKGROUND_ALPHA=0.05
# Frames are downscaled to this width before they're compared.
DETECT_WIDTH=320

# Live ingestion (python -m services.ingestion, ADR 0014)
# Folder for the rolling buffer (data/buffer) and footage waiting to be stored (data/outbox).
INGESTION_DATA_DIR=data
# How often the camera list is read again (seconds).
CAMERA_RELOAD_SECONDS=30
# Snapshot for the Live cameras page, and the largest width of frames and snapshots.
SNAPSHOT_INTERVAL_SECONDS=5
SNAPSHOT_WIDTH=960
# Long activity is stored as back-to-back segments of at most this many seconds (ADR 0015).
MAX_SEGMENT_SECONDS=30
# No video for this long and the stream is restarted; the longest wait between reconnects.
STREAM_STALL_SECONDS=15
RECONNECT_MAX_BACKOFF_SECONDS=30

# Simulated cameras (docker compose --profile sim up -d): the videos they loop. Make the
# defaults with `python -m tests.ingestion.videos test-data/sim`, or use any video.
SIM_CAM01_VIDEO=./test-data/sim/cam-01.mp4
SIM_CAM02_VIDEO=./test-data/sim/cam-02.mp4
