# Copy to .env (git-ignored): `copy .env.example .env`
# Development defaults. Change every password before using a shared machine.

# Interface the Docker services listen on. 127.0.0.1 = this machine only.
BIND_ADDRESS=127.0.0.1

# PostgreSQL
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_password
POSTGRES_DB=sentinel
POSTGRES_HOST=localhost
# 5433 because a local PostgreSQL may already own 5432
POSTGRES_PORT=5433

# MinIO
MINIO_ACCESS_KEY=sentinel
MINIO_SECRET_KEY=sentinel_dev_password
MINIO_BUCKET=sentinel
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis
REDIS_HOST=localhost
# 6380 because another Redis may already own 6379
REDIS_PORT=6380

# MediaMTX (RTSP server)
MEDIAMTX_HOST=localhost
MEDIAMTX_RTSP_PORT=8554

# Key that encrypts camera source URIs (used from step 1.4). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
